# Configura el proxy de tu red si es necesario. No pongas credenciales en Git.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# Reservada para futuras funciones: la aplicación actual no hace llamadas a OpenAI.
OPENAI_API_KEY=

# Ruta relativa al proyecto. La base se crea automáticamente y no entra en Git.
FOLIO_DATABASE=data/folio.sqlite3
