# Configura el proxy de tu red si es necesario. No pongas credenciales en Git.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# Clave del RAG. La interfaz guiada /api/chat no consume llamadas al modelo.
OPENAI_API_KEY=
RAG_MODELO=gpt-6-luna
RAG_MODELO_EMBEDDINGS=text-embedding-3-small
RAG_UMBRAL=0.30
RAG_K=4

# Ruta relativa al proyecto. La base se crea automáticamente y no entra en Git.
FOLIO_DATABASE=data/folio.sqlite3
